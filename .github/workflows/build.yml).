          package com.vivo.funtouch.shortcutcenter
          import android.annotation.SuppressLint
          import android.app.Service
          import android.content.Context
          import android.content.Intent
          import android.graphics.PixelFormat
          import android.hardware.camera2.CameraManager
          import android.media.AudioManager
          import android.os.IBinder
          import android.provider.Settings
          import android.view.*
          import android.widget.TextView
          import androidx.recyclerview.widget.GridLayoutManager
          import androidx.recyclerview.widget.RecyclerView

          class VivoOverlayService : Service() {
              private lateinit var wm: WindowManager
              private lateinit var triggerView: View
              private lateinit var panelView: View
              private var isPanelOpen = false
              private var isTorchOn = false

              override fun onBind(intent: Intent?): IBinder? = null
              override fun onCreate() {
                  super.onCreate()
                  wm = getSystemService(Context.WINDOW_SERVICE) as WindowManager
                  setupBottomTrigger()
                  setupVivoPanel()
              }
              @SuppressLint("ClickableViewAccessibility")
              private fun setupBottomTrigger() {
                  val params = WindowManager.LayoutParams(
                      WindowManager.LayoutParams.MATCH_PARENT, 36,
                      WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
                      WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
                      PixelFormat.TRANSLUCENT
                  ).apply { gravity = Gravity.BOTTOM }
                  triggerView = View(this)
                  var startY = 0f
                  triggerView.setOnTouchListener { _, event ->
                      when (event.action) {
                          MotionEvent.ACTION_DOWN -> { startY = event.rawY; true }
                          MotionEvent.ACTION_MOVE -> {
                              if (startY - event.rawY > 40 && !isPanelOpen) showPanel()
                              true
                          }
                          else -> false
                      }
                  }
                  wm.addView(triggerView, params)
              }
              private fun setupVivoPanel() {
                  panelView = LayoutInflater.from(this).inflate(R.layout.layout_vivo_shortcut_center, null)
                  val brightness = panelView.findViewById<VivoVerticalSlider>(R.id.sliderBrightness)
                  val volume = panelView.findViewById<VivoVerticalSlider>(R.id.sliderVolume)
                  val audioManager = getSystemService(Context.AUDIO_SERVICE) as AudioManager
                  val rvTiles = panelView.findViewById<RecyclerView>(R.id.rvActiveTiles)
                  brightness.iconText = "☀"
                  volume.iconText = "🔊"
                  volume.onProgressChanged = { pct ->
                      val max = audioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC)
                      audioManager.setStreamVolume(AudioManager.STREAM_MUSIC, (pct * max).toInt(), 0)
                  }
                  brightness.onProgressChanged = { pct ->
                      if (Settings.System.canWrite(this)) {
                          Settings.System.putInt(contentResolver, Settings.System.SCREEN_BRIGHTNESS, (pct * 255).toInt())
                      }
                  }
                  val activeTiles = CustomTilesActivity.allTiles.filter { it.isDisplayed }.toMutableList()
                  val adapter = TileAdapter(activeTiles) { tile, pos ->
                      when (tile.id) {
                          "torch" -> {
                              try {
                                  val cm = getSystemService(Context.CAMERA_SERVICE) as CameraManager
                                  isTorchOn = !isTorchOn
                                  cm.setTorchMode(cm.cameraIdList[0], isTorchOn)
                              } catch (e: Exception) {}
                          }
                          "wifi" -> startActivity(Intent(Settings.ACTION_WIFI_SETTINGS).apply { addFlags(Intent.FLAG_ACTIVITY_NEW_TASK) })
                          "bluetooth" -> startActivity(Intent(Settings.ACTION_BLUETOOTH_SETTINGS).apply { addFlags(Intent.FLAG_ACTIVITY_NEW_TASK) })
                          "location" -> startActivity(Intent(Settings.ACTION_LOCATION_SOURCE_SETTINGS).apply { addFlags(Intent.FLAG_ACTIVITY_NEW_TASK) })
                      }
                      tile.isActive = !tile.isActive
                      rvTiles.adapter?.notifyItemChanged(pos)
                  }
                  rvTiles.layoutManager = GridLayoutManager(this, 3)
                  rvTiles.adapter = adapter

                  panelView.findViewById<TextView>(R.id.btnCustomTiles).setOnClickListener {
                      hidePanel()
                      startActivity(Intent(this, CustomTilesActivity::class.java).apply { addFlags(Intent.FLAG_ACTIVITY_NEW_TASK) })
                  }
                  panelView.findViewById<View>(R.id.btnClose).setOnClickListener { hidePanel() }
                  panelView.findViewById<View>(R.id.panelOverlayRoot).setOnClickListener { hidePanel() }
              }
              private fun showPanel() {
                  if (isPanelOpen) return
                  setupVivoPanel()
                  val params = WindowManager.LayoutParams(
                      WindowManager.LayoutParams.MATCH_PARENT, WindowManager.LayoutParams.MATCH_PARENT,
                      WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
                      WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
                      PixelFormat.TRANSLUCENT
                  )
                  wm.addView(panelView, params)
                  isPanelOpen = true
              }
              private fun hidePanel() {
                  if (!isPanelOpen) return
                  wm.removeView(panelView)
                  isPanelOpen = false
              }
              override fun onDestroy() {
                  super.onDestroy()
                  if (::triggerView.isInitialized) wm.removeView(triggerView)
                  if (isPanelOpen) wm.removeView(panelView)
              }
          }
