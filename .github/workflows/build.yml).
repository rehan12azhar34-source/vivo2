          package com.vivo.funtouch.shortcutcenter
          import android.content.Context
          import android.graphics.*
          import android.util.AttributeSet
          import android.view.MotionEvent
          import android.view.View

          class VivoVerticalSlider @JvmOverloads constructor(
              context: Context, attrs: AttributeSet? = null, defStyle: Int = 0
          ) : View(context, attrs, defStyle) {
              var progress: Float = 0.5f
                  set(value) { field = value.coerceIn(0f, 1f); invalidate() }
              var onProgressChanged: ((Float) -> Unit)? = null
              var iconText: String = "☀"
              private val trackPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.parseColor("#403C4454") }
              private val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.WHITE }
              private val textPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
                  color = Color.BLACK; textSize = 38f; textAlign = Paint.Align.CENTER
              }
              override fun onDraw(canvas: Canvas) {
                  super.onDraw(canvas)
                  val r = width / 2f
                  canvas.drawRoundRect(RectF(0f, 0f, width.toFloat(), height.toFloat()), r, r, trackPaint)
                  val fillTop = height * (1f - progress)
                  canvas.drawRoundRect(RectF(0f, fillTop, width.toFloat(), height.toFloat()), r, r, fillPaint)
                  canvas.drawText(iconText, width / 2f, height - 30f, textPaint)
              }
              override fun onTouchEvent(event: MotionEvent): Boolean {
                  when (event.action) {
                      MotionEvent.ACTION_DOWN, MotionEvent.ACTION_MOVE -> {
                          progress = 1f - (event.y.coerceIn(0f, height.toFloat()) / height)
                          onProgressChanged?.invoke(progress)
                          return true
                      }
                  }
                  return super.onTouchEvent(event)
              }
          }
