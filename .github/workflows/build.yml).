          package com.vivo.funtouch.shortcutcenter
          import android.os.Bundle
          import android.widget.TextView
          import androidx.appcompat.app.AppCompatActivity
          import androidx.recyclerview.widget.GridLayoutManager
          import androidx.recyclerview.widget.RecyclerView

          class CustomTilesActivity : AppCompatActivity() {
              companion object {
                  var allTiles: ArrayList<ShortcutTile> = TileRegistry.getDefaultTiles()
              }
              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)
                  setContentView(R.layout.activity_custom)
                  val rvActive = findViewById<RecyclerView>(R.id.rvCustomActive)
                  val rvAvailable = findViewById<RecyclerView>(R.id.rvCustomAvailable)
                  val activeList = allTiles.filter { it.isDisplayed }.toMutableList()
                  val availableList = allTiles.filter { !it.isDisplayed }.toMutableList()

                  val activeAdapter = TileAdapter(activeList) { tile, pos ->
                      tile.isDisplayed = false
                      activeList.removeAt(pos)
                      availableList.add(tile)
                      rvActive.adapter?.notifyDataSetChanged()
                      rvAvailable.adapter?.notifyDataSetChanged()
                  }
                  val availableAdapter = TileAdapter(availableList) { tile, pos ->
                      tile.isDisplayed = true
                      availableList.removeAt(pos)
                      activeList.add(tile)
                      activeAdapter.notifyDataSetChanged()
                      rvAvailable.adapter?.notifyDataSetChanged()
                  }
                  rvActive.layoutManager = GridLayoutManager(this, 3)
                  rvActive.adapter = activeAdapter
                  rvAvailable.layoutManager = GridLayoutManager(this, 2)
                  rvAvailable.adapter = availableAdapter
                  findViewById<TextView>(R.id.btnDone).setOnClickListener { finish() }
              }
          }
