          cat << 'EOF' > app/src/main/java/com/vivo/funtouch/shortcutcenter/TileAdapter.kt
          package com.vivo.funtouch.shortcutcenter
          import android.graphics.Color
          import android.view.*
          import android.widget.FrameLayout
          import android.widget.TextView
          import androidx.recyclerview.widget.RecyclerView

          class TileAdapter(
              val tiles: MutableList<ShortcutTile>,
              private val onTileClick: (ShortcutTile, Int) -> Unit
          ) : RecyclerView.Adapter<TileAdapter.ViewHolder>() {
              inner class ViewHolder(v: View) : RecyclerView.ViewHolder(v) {
                  val bg: FrameLayout = v.findViewById(R.id.tileBackground)
                  val icon: TextView = v.findViewById(R.id.tileIcon)
                  val label: TextView = v.findViewById(R.id.tileLabel)
              }
              override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): ViewHolder {
                  val v = LayoutInflater.from(parent.context).inflate(R.layout.item_vivo_tile, parent, false)
                  return ViewHolder(v)
              }
              override fun onBindViewHolder(holder: ViewHolder, position: Int) {
                  val tile = tiles[position]
                  holder.label.text = tile.title
                  holder.icon.text = tile.icon
                  if (tile.isActive) {
                      holder.bg.setBackgroundResource(R.drawable.bg_circle_toggle_active)
                      holder.icon.setTextColor(Color.BLACK)
                  } else {
                      holder.bg.setBackgroundResource(R.drawable.bg_circle_toggle_inactive)
                      holder.icon.setTextColor(Color.WHITE)
                  }
                  holder.itemView.setOnClickListener { onTileClick(tile, position) }
              }
              override fun getItemCount(): Int = tiles.size
          }
